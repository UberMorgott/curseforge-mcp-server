# CurseForge Core API key (from https://console.curseforge.com/)
CURSEFORGE_API_KEY=

# CurseForge Author/Upload API token (from account API tokens page)
CURSEFORGE_AUTHOR_TOKEN=

# Optional: default game slug (e.g. hytale, minecraft) for get_upload_game_versions /
# get_upload_game_version_types when game_slug is not passed. Not a host — uploads
# always go to the universal www.curseforge.com.
# CURSEFORGE_GAME_SLUG=

# Optional: confines upload_file reads to this directory (empty = no confinement)
# CURSEFORGE_UPLOAD_DIR=
